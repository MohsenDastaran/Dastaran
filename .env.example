# Blog API (used by src/lib/blog-api.ts)
# Optional. Defaults to https://api.dastaran.com/
BLOG_API_URL=
# Bearer token for preview, publish, and delete. Also unlocks /blog/preview/{slug}/
BLOG_API_TOKEN=

# Turso / libSQL (optional in local dev — src/db/index.ts uses file:local.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Contact form (Resend)
RESEND_API_KEY=

# AI chat
CHAT_KNOWLEDGE_BASE=
# Local AI Gateway auth. Production injects this automatically on Vercel.
VERCEL_OIDC_TOKEN=
