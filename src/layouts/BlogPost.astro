---
import type { CollectionEntry } from "astro:content";
import type { BlogPostCard } from "@/lib/posts";
import BaseHead from "../components/BaseHead.astro";
import RootLayout from "./RootLayout.astro";
import type { ReadingTime } from "@/lib/readingTime";
import type { TocEntry } from "@/lib/posts";
import { formatDate } from "@/lib/format";
import { cn, slugify } from "@/lib/utils";
import Avatar from "@/components/Avatar.astro";
import { SOCIAL_LINKS } from "@/data/socials";
import { Badge, badgeVariants } from "@/components/react/ui/badge";
import { PencilIcon } from "@phosphor-icons/react/dist/ssr/Pencil";
import TableOfContents from "@/components/TableOfContents.astro";
import ViewCount from "@/components/ViewCount.astro";
import Skeleton from "@/components/Skeleton.astro";
import Schema from "@/components/Schema.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import Comments from "@/components/Comments.astro";
import { DUMMY_COMMENTS } from "@/data/comments";
import { breadcrumbSchema, personRef, websiteRef } from "@/lib/schema";
import { getEntries } from "astro:content";
import BlogPreviewActions, {
  type BlogPreviewDraft,
} from "@/components/react/BlogPreviewActions";

type Props = CollectionEntry<"blog">["data"] & {
  readingTime: ReadingTime;
  headings: Array<TocEntry>;
  relatedPosts?: Array<BlogPostCard>;
  isPreview?: boolean;
  slug?: string;
  previewDraft?: BlogPreviewDraft;
};

const {
  title,
  description,
  publicationDate,
  modificationDate,
  cover,
  readingTime,
  tags,
  headings,
  authors: authorsReferences,
  showComments,
  relatedPosts = [],
  isPreview = false,
  slug,
  previewDraft,
} = Astro.props;

const authors = await getEntries(authorsReferences);

const { pathname, origin, href } = Astro.url;

const formattedPublicationDate = formatDate(publicationDate);
const formattedModificationDate = modificationDate
  ? formatDate(modificationDate)
  : null;
// Remote covers are absolute URLs from the API. Otherwise resolve "og.png"
// relative to the post URL (which ends in a slash), so the trailing slash
// joins cleanly instead of producing a `//og.png` redirect. Preview URLs have
// no generated OG image, so missing covers fall back to the site default.
const coverImageURL =
  cover ?? (isPreview ? undefined : new URL("og.png", href).href);

// Reference the shared Person entity when the post is written by the site owner,
// otherwise inline a Person for the guest author.
const primaryAuthor = authors[0];
const authorNode =
  primaryAuthor.id === "MohsenDastaran"
    ? personRef(origin)
    : { "@type": "Person" as const, name: primaryAuthor.data.name };

// Google's Article rich result wants an ImageObject with dimensions. Remote
// covers don't ship width/height, so we use the OG fallback size of 1200x630.
const articleImage = coverImageURL
  ? {
      "@type": "ImageObject" as const,
      url: coverImageURL,
      width: "1200",
      height: "630",
    }
  : undefined;
---

<RootLayout>
  <BaseHead
    title={isPreview ? `Preview: ${title}` : title}
    description={description}
    image={coverImageURL}
    ogType={isPreview ? "website" : "article"}
    noindex={isPreview}
    slot="head"
  >
    {
      !isPreview && (
        <>
          <meta property="article:author" content={authors[0].data.name} />
          <meta
            property="article:published_time"
            content={publicationDate.toISOString()}
          />
          {modificationDate && (
            <meta
              property="article:modified_time"
              content={modificationDate.toISOString()}
            />
          )}
          {tags?.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
          <Schema
            item={{
              "@context": "https://schema.org",
              "@type": "BlogPosting",
              "@id": `${href}#article`,
              headline: title,
              description,
              datePublished: publicationDate.toISOString(),
              dateModified: (modificationDate ?? publicationDate).toISOString(),
              image: articleImage,
              mainEntityOfPage: { "@id": href },
              isPartOf: websiteRef(origin),
              inLanguage: "en",
              author: authorNode,
              publisher: personRef(origin),
              keywords: tags?.join(", "),
            }}
          />
          <Schema
            item={breadcrumbSchema(origin, [
              { name: "Home", url: "/" },
              { name: "Blog", url: "/blog/" },
              { name: title, url: pathname },
            ])}
          />
        </>
      )
    }
  </BaseHead>
  <article class="flex w-full flex-col gap-12">
    {
      isPreview && slug && previewDraft ? (
        <div
          class="sticky top-16 z-30 mx-auto flex w-full max-w-3xl flex-col gap-3
            rounded-xl border bg-card p-4 shadow-sm offset-border sm:flex-row
            sm:items-center sm:justify-between"
        >
          <p class="text-sm text-muted-foreground">
            This post is under review. It is not public, not in the sitemap, and
            will not appear on /blog until you publish.
          </p>
          <BlogPreviewActions client:load slug={slug} draft={previewDraft} />
        </div>
      ) : null
    }
    <header
      class={cn(
        "mx-auto prose w-full prose-neutral dark:prose-invert",
        cover !== undefined ? "sm:text-center" : "",
      )}
    >
      <h1 class="leading-tight">
        {title}
      </h1>
      <div class="not-prose inline-flex flex-wrap items-center gap-2">
        <div class="inline-flex items-center gap-2 text-sm">
          <Avatar loading="eager" class="size-10 rounded-full" />
          <div class="space-y-1">
            <p>Dastaran</p>
            <div class="flex items-center gap-2">
              {
                SOCIAL_LINKS.map(({ href, logo: Logo, name }) => {
                  return (
                    <a
                      href={href}
                      target="_blank"
                      rel="noreferrer"
                      class="text-muted-foreground hover:text-primary"
                    >
                      <span class="sr-only">Link to {name} profile</span>
                      <Logo weight="duotone" size={20} />
                    </a>
                  );
                })
              }
            </div>
          </div>
        </div>
        <span>•</span>
        <div class="inline-flex gap-2 text-sm">
          <time datetime={publicationDate.toISOString()}>
            {formattedPublicationDate}
          </time>
          {
            readingTime > 0 ? (
              <>
                <span>•</span>
                <span>{readingTime} min read</span>
              </>
            ) : null
          }
        </div>
        {
          isPreview ? (
            <Badge
              className="bg-orange-500/20 text-orange-600 dark:text-orange-400"
            >
              <PencilIcon size={16} weight="duotone" />
              Under review
            </Badge>
          ) : null
        }
      </div>
      <p class="text-muted-foreground">
        {description}
      </p>
      {
        tags && tags.length > 0 ? (
          <div class="inline-flex flex-wrap gap-2">
            {tags.map((tag) => {
              return (
                <a
                  class={cn(
                    badgeVariants({ variant: "secondary" }),
                    "no-underline",
                  )}
                  href={`/blog?tag=${slugify(tag)}`}
                  data-astro-prefetch
                >
                  {tag}
                </a>
              );
            })}
          </div>
        ) : null
      }
    </header>

    {
      cover && (
        <div
          class="relative mx-auto aspect-video w-full max-w-[1200px]
            overflow-hidden rounded-2xl sm:border sm:p-2"
        >
          <img
            src={cover}
            alt=""
            loading="eager"
            class="absolute aspect-video size-full object-cover blur-3xl"
          />
          <img
            src={cover}
            loading="eager"
            fetchpriority="high"
            alt={`Cover image for "${title}"`}
            class="relative aspect-video size-full rounded-xl object-cover
              sm:border"
          />
        </div>
      )
    }

    <div
      class="relative grid grid-cols-1 items-start justify-end gap-8
        md:grid-cols-[1fr_auto_1fr]"
    >
      <section
        class="prose prose-neutral md:col-start-2 dark:prose-invert
          prose-a:decoration-sky-500 prose-a:underline-offset-4"
      >
        {
          modificationDate ? (
            <time
              class={cn(
                badgeVariants({ variant: "secondary" }),
                "bg-sky-500/20 text-sky-600 dark:text-sky-400",
              )}
              datetime={modificationDate.toISOString()}
            >
              Last updated: {formattedModificationDate}
            </time>
          ) : null
        }
        <slot />
      </section>
      {
        headings.length > 0 && (
          <TableOfContents
            class={`rounded-xl border bg-card bg-linear-to-b shadow-sm
              offset-border max-xl:order-first md:col-start-2 xl:sticky
              xl:top-16 xl:col-start-3 xl:max-h-[calc(100dvh_-_--spacing(24))]
              xl:max-w-xs xl:overflow-y-auto`}
            headings={headings}
          />
        )
      }
    </div>

    <RelatedPosts posts={relatedPosts} />

    {!isPreview && showComments ? <Comments comments={DUMMY_COMMENTS} /> : null}
  </article>
</RootLayout>
