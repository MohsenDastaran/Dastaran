---
import BlogPost from "@/layouts/BlogPost.astro";
import { estimateReadingTime } from "@/lib/readingTime";
import { generatePostHeadings, getRelatedPosts } from "@/lib/posts";
import { fetchPublishedBlogPost, resolveAuthorIds } from "@/lib/blog-api";
import { renderBlogMarkdown } from "@/lib/render-blog-markdown";
import MarkdownBody from "@/components/MarkdownBody.astro";

export const prerender = false;

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join("/") : slugParam;
if (!slug) {
  return Astro.rewrite("/404");
}

const post = await fetchPublishedBlogPost(slug);
if (!post) {
  return Astro.rewrite("/404");
}

const readingTime = estimateReadingTime(post.body);
const { html, headings: markdownHeadings } = await renderBlogMarkdown(
  post.body,
);
const headings = generatePostHeadings(markdownHeadings);
const relatedPosts = await getRelatedPosts({
  id: post.slug,
  data: { tags: post.tags },
});
const authorIds = resolveAuthorIds(post.authors);
---

<BlogPost
  slug={post.slug}
  title={post.title}
  description={post.description}
  publicationDate={post.publicationDate}
  modificationDate={post.modificationDate ?? undefined}
  cover={post.cover ?? undefined}
  tags={post.tags}
  showComments={post.showComments}
  authors={authorIds.map((id) => ({ collection: "authors", id }))}
  readingTime={readingTime}
  headings={headings}
  relatedPosts={relatedPosts}
>
  <MarkdownBody html={html} />
</BlogPost>
