---
import { type CollectionEntry, render } from "astro:content";
import BlogPost from "@/layouts/BlogPost.astro";
import { estimateReadingTime } from "@/lib/readingTime";
import { getRelatedPosts, generatePostHeadings } from "@/lib/posts";
import BlogImage from "@/components/BlogImage.astro";
import BlogLink from "@/components/BlogLink.astro";
import CodeBlock from "@/components/CodeBlock.astro";

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;
const readingTime = estimateReadingTime(post.body);
const { Content, headings: getHeadings } = await render(post);
const headings = generatePostHeadings(getHeadings);
const relatedPosts = await getRelatedPosts(post);
---

<BlogPost
  readingTime={readingTime}
  headings={headings}
  relatedPosts={relatedPosts}
  slug={post.id}
  {...post.data}
>
  <!-- TODO: Prevent empty paragraphs from being created for img  -->
  <Content components={{ img: BlogImage, a: BlogLink, pre: CodeBlock }} />
</BlogPost>
