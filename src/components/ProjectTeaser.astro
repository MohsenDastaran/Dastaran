---
import { cn } from "@/lib/utils";
import { Badge } from "@/components/react/ui/badge";
import { GithubLogoIcon } from "@phosphor-icons/react/dist/ssr/GithubLogo";
import { LinkSimpleIcon } from "@phosphor-icons/react/dist/ssr/LinkSimple";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import type { HTMLAttributes } from "astro/types";
import { buttonVariants } from "./react/ui/button";

type Props = CollectionEntry<"projects">["data"] &
  HTMLAttributes<"div"> & {
    loading?: "eager" | "lazy";
  };

const {
  tags,
  description,
  image,
  title,
  github,
  link,
  loading,
  class: className,
  ...props
} = Astro.props;
---

<div
  class={cn(
    `relative flex w-full min-w-0 flex-col justify-start gap-2 overflow-hidden
    rounded-xl bg-card p-4 offset-border`,
    className,
  )}
  {...props}
>
  <div
    class="absolute top-2 right-2 z-10 flex max-w-[calc(100%-1rem)] flex-wrap
      items-center justify-end gap-1 text-xs"
  >
    {
      tags.map((tag) => (
        <Badge
          className="bg-sky-100 text-sky-700 dark:bg-sky-950 dark:text-sky-400"
        >
          {tag}
        </Badge>
      ))
    }
  </div>
  <div class="relative min-w-0">
    <div
      class="absolute inset-0 bg-linear-to-b from-transparent via-transparent
        to-card to-95%"
    >
    </div>
    <Image
      src={image}
      alt={title}
      width={700}
      quality="high"
      loading={loading}
      class="aspect-4/3 h-auto w-full rounded-lg object-cover"
    />
  </div>

  <div
    class="absolute inset-x-4 bottom-4 z-10 flex flex-col gap-3 sm:flex-row
      sm:items-end sm:justify-between sm:gap-4"
  >
    <div class="flex min-w-0 flex-1 flex-col">
      <h3 class="truncate text-lg font-bold">{title}</h3>
      <p class="line-clamp-2 text-xs text-muted-foreground">{description}</p>
    </div>
    {
      github || link ? (
        <div class="flex shrink-0 items-center gap-2">
          {link ? (
            <a
              href={link}
              target="_blank"
              rel="noopener noreferrer"
              class={buttonVariants()}
            >
              <LinkSimpleIcon weight="duotone" size={20} />
              Visit
            </a>
          ) : null}
          {github ? (
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class={buttonVariants({ variant: "secondary", size: "icon" })}
            >
              <GithubLogoIcon weight="duotone" size={20} />
              <span class="sr-only">Link to GitHub repository</span>
            </a>
          ) : null}
        </div>
      ) : null
    }
  </div>
</div>
